{
  "name": "the-rivalry",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "start:railway": "node scripts/check-railway-env.mjs && exec next start --hostname 0.0.0.0 --port \"${PORT:-3000}\"",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "test:e2e": "playwright test",
    "admin:setup": "node scripts/admin-setup.mjs",
    "test:admin": "SITE_INDEXABLE=false NEXT_PUBLIC_SITE_URL=http://localhost:3002 next build && playwright test -c playwright.admin.config.ts",
    "db:migrate": "tsx --env-file=.env.local scripts/migrate-database.ts",
    "db:setup": "tsx scripts/setup-postgres.ts",
    "db:backup": "node scripts/backup-postgres.mjs",
    "test:cache": "tsx tests/integration/public-cache.ts"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.2.8",
    "@fontsource-variable/roboto-condensed": "^5.3.0",
    "@radix-ui/react-popover": "^1.1.23",
    "@radix-ui/react-select": "^2.3.7",
    "@tiptap/extension-image": "^3.31.3",
    "@tiptap/extension-table": "^3.31.3",
    "@tiptap/pm": "^3.31.3",
    "@tiptap/react": "^3.31.3",
    "@tiptap/starter-kit": "^3.31.3",
    "@vercel/analytics": "^2.0.1",
    "better-sqlite3": "^13.0.3",
    "lucide-react": "^0.577.0",
    "next": "16.3.5",
    "postgres": "^3.4.9",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "sharp": "^0.35.5",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "1.63.0",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "eslint": "^9.0.0",
    "eslint-config-next": "16.3.5",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  },
  "engines": {
    "node": "22.x"
  }
}
