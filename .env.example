# Production: https://messivsronaldo17.com. Keep localhost for local development.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Leave false for private previews. Enable only on your intended production domain.
SITE_INDEXABLE=false
# Temporary outages only. Set true and redeploy to show a 503 maintenance screen.
# Admin sign-in and robots.txt remain available. Set false and redeploy to reopen.
MAINTENANCE_MODE=false
# Optional verified owner address for an additional direct contact link.
# The contact form delivers to /admin/support without an email service.
CONTACT_EMAIL=
# Public, owner-confirmed editorial identity; never derive this from ADMIN_EMAIL.
# Both name and biography are required to display an editor profile and schema.
EDITOR_NAME=
EDITOR_BIO=
EDITOR_PROFILE_URL=
# Optional real AdSense ID (pub- plus 16 digits), once assigned by Google.
# Adds site verification and ads.txt only. Redeploy after setting it.
# Ads are not activated: configure Google's certified consent message and update
# advertising disclosures before adding ad scripts or enabling personalized ads.
ADSENSE_PUBLISHER_ID=
# Cookieless public-page analytics on Vercel; set false to disable and redeploy.
WEB_ANALYTICS_ENABLED=true
# Optional Google Search Console verification token.
GOOGLE_SITE_VERIFICATION=
# Run npm run admin:setup -- --email you@example.com to configure local access.
# Keep these stable in your production host's private environment settings.
ADMIN_EMAIL=
ADMIN_PASSWORD_HASH=
ADMIN_SESSION_SECRET=
# Private random secret for Vercel's daily stats job (production only).
# Generate with: openssl rand -hex 32
CRON_SECRET=
# Private token shared with the production-health GitHub Actions workflow.
HEALTHCHECK_SECRET=
# Production uses Neon's pooled Postgres connection URL.
# The existing server driver disables prepared statements for transaction pooling.
# Never expose this URL with a NEXT_PUBLIC_ prefix.
DATABASE_URL=
# Local development can keep SQLite. Default: .data/admin.sqlite
# Example for a Node host with a mounted persistent volume:
# ADMIN_DATABASE_PATH=/var/lib/rivalry/admin.sqlite
